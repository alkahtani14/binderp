            <field name="reviewer_name">Nora Al-Zahrani</field>
            <field name="rating_label">FIVE</field>
            <field name="rating">5</field>
            <field name="review_text">The north branch team is fantastic. Clean workshop, honest quotes, and the car was ready exactly when they said it would be. Best auto service experience I have had in Riyadh.</field>
