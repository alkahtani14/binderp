        <!-- ============================================================
             Demo Reviews — Main Branch
             ============================================================ -->
        <record id="demo_review_5star_ahmed" model="google.business.review">
            <field name="location_id" ref="demo_location_main"/>
            <field name="google_review_id">ChZDSElCbTJ2aTJINGpWQVBNbENMaV9BEAA</field>
            <field name="reviewer_name">Ahmed Al-Rashidi</field>
            <field name="rating_label">FIVE</field>
            <field name="rating">5</field>
            <field name="review_text">Excellent service from start to finish! The team diagnosed my car's issue within minutes and had it repaired the same day. Very professional, honest pricing, and they even washed the car before returning it. Highly recommend Garage Systems to anyone looking for reliable auto service in Riyadh.</field>
            <field name="review_date" eval="(DateTime.now() - timedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">new</field>
            <field name="is_replied">False</field>
        </record>

        <record id="demo_review_5star_sarah" model="google.business.review">
            <field name="location_id" ref="demo_location_main"/>
            <field name="google_review_id">ChZDSElCbTJ2aTJINGpWQVBNbENMaV9BEAB</field>
            <field name="reviewer_name">Sarah Johnson</field>
            <field name="rating_label">FIVE</field>
            <field name="rating">5</field>
            <field name="review_text">I have been coming here for three years and the quality never drops. Mohammed and his team always go above and beyond. Today they fit me in without an appointment and still had my car ready within 2 hours. Outstanding!</field>
            <field name="review_date" eval="(DateTime.now() - timedelta(days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">replied</field>
            <field name="is_replied">True</field>
        </record>

        <record id="demo_reply_sarah" model="google.business.review.reply">
            <field name="review_id" ref="demo_review_5star_sarah"/>
            <field name="reply_text">Thank you so much for your continued loyalty, Sarah! Three years of trust means everything to us. We will pass your kind words on to Mohammed and the team — they will be delighted to hear this. See you on your next service!</field>
            <field name="is_published">True</field>
            <field name="author_id" ref="base.user_admin"/>
            <field name="reply_date" eval="(DateTime.now() - timedelta(days=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="demo_review_4star_khalid" model="google.business.review">
            <field name="location_id" ref="demo_location_main"/>
            <field name="google_review_id">ChZDSElCbTJ2aTJINGpWQVBNbENMaV9BEAC</field>
            <field name="reviewer_name">Khalid Al-Otaibi</field>
            <field name="rating_label">FOUR</field>
            <field name="rating">4</field>
            <field name="review_text">Good service overall. The technician was knowledgeable and fixed my AC problem efficiently. The only reason for 4 stars is the waiting area could use some improvement. Will definitely return.</field>
            <field name="review_date" eval="(DateTime.now() - timedelta(days=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">read</field>
            <field name="is_replied">False</field>
        </record>

        <record id="demo_review_2star_negative" model="google.business.review">
            <field name="location_id" ref="demo_location_main"/>
            <field name="google_review_id">ChZDSElCbTJ2aTJINGpWQVBNbENMaV9BEAD</field>
            <field name="reviewer_name">Omar Hassan</field>
            <field name="rating_label">TWO</field>
            <field name="rating">2</field>
            <field name="review_text">Waited over 3 hours for what was supposed to be a 45-minute job. No updates were provided and I had to keep asking for the status. The work quality was fine but the communication and time management need serious improvement.</field>
            <field name="review_date" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">new</field>
            <field name="is_replied">False</field>
        </record>

        <record id="demo_review_rating_only" model="google.business.review">
