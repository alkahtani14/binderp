        <record id="demo_post_ramadan" model="google.business.post">
            <field name="title">Ramadan Special — Free Vehicle Health Check</field>
            <field name="location_id" ref="demo_location_main"/>
            <field name="post_type">OFFER</field>
            <field name="state">published</field>
            <field name="summary">This Ramadan, we are offering a FREE comprehensive vehicle health check for all customers. Visit us between now and the end of the holy month and our certified technicians will inspect your vehicle at no charge. Book your slot today!</field>
            <field name="cta_type">BOOK</field>
            <field name="cta_url">https://www.garagesystems.io/book</field>
            <field name="offer_coupon_code">RAMADAN2026</field>
            <field name="offer_terms">Valid for one vehicle per customer. Offer valid during Ramadan 2026 only. Excludes parts and labour for any identified repairs.</field>
            <field name="publish_date" eval="(DateTime.now() - timedelta(days=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="view_count">1842</field>
            <field name="click_count">287</field>
            <field name="google_post_id">accounts/1234567890/locations/0987654321/localPosts/ram2026</field>
        </record>

        <record id="demo_post_news" model="google.business.post">
            <field name="title">New Diagnostic Equipment — Faster, More Accurate Service</field>
            <field name="location_id" ref="demo_location_main"/>
            <field name="post_type">STANDARD</field>
            <field name="state">published</field>
            <field name="summary">We have just invested in the latest OBD-III diagnostic equipment, enabling our technicians to identify issues faster and more accurately than ever before. This means less time in the workshop and more accurate repair quotes for you. Visit us to experience the difference!</field>
            <field name="cta_type">LEARN_MORE</field>
            <field name="cta_url">https://www.garagesystems.io/diagnostic</field>
            <field name="publish_date" eval="(DateTime.now() - timedelta(days=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="view_count">623</field>
            <field name="click_count">89</field>
            <field name="google_post_id">accounts/1234567890/locations/0987654321/localPosts/diag2026</field>
        </record>

        <record id="demo_post_draft" model="google.business.post">
