<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Location Profile Report Action
         Dynamic file name: "GBP Profile - {Location Name}"
         ================================================================ -->
    <record id="action_report_google_business_location" model="ir.actions.report">
        <field name="name">Location Profile</field>
        <field name="model">google.business.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gs_google_business.report_google_business_location_document</field>
        <field name="report_file">gs_google_business.report_google_business_location_document</field>
        <field name="print_report_name">'GBP Profile - %s' % object.name</field>
        <field name="binding_model_id" ref="model_google_business_location"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('gs_google_business.group_user'))]"/>
    </record>

    <!-- ================================================================
         Review Report Action
         Dynamic file name: "GBP Reviews - {Location Name}"
         ================================================================ -->
    <record id="action_report_google_business_reviews" model="ir.actions.report">
        <field name="name">Review Report</field>
        <field name="model">google.business.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gs_google_business.report_google_business_review_document</field>
        <field name="report_file">gs_google_business.report_google_business_review_document</field>
        <field name="print_report_name">'GBP Reviews - %s' % object.name</field>
        <field name="binding_model_id" ref="model_google_business_location"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('gs_google_business.group_user'))]"/>
    </record>

</odoo>
