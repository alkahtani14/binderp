<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Security Groups
         ================================================================ -->

    <record id="group_user" model="res.groups">
        <field name="name">Google Business / User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Google Business / Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('gs_google_business.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ================================================================
         Record Rules — Company isolation
         ================================================================ -->

    <!-- Hours inherit company from their parent location via the join -->
    <record id="google_business_location_hours_rule_company" model="ir.rule">
        <field name="name">Google Business Hours: company isolation</field>
        <field name="model_id" ref="model_google_business_location_hours"/>
        <field name="domain_force">[('location_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('gs_google_business.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="google_business_location_rule_company" model="ir.rule">
        <field name="name">Google Business Location: company isolation</field>
        <field name="model_id" ref="model_google_business_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('gs_google_business.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="google_business_review_rule_company" model="ir.rule">
        <field name="name">Google Business Review: company isolation</field>
        <field name="model_id" ref="model_google_business_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('gs_google_business.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="google_business_media_rule_company" model="ir.rule">
        <field name="name">Google Business Media: company isolation</field>
        <field name="model_id" ref="model_google_business_media"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('gs_google_business.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="google_business_post_rule_company" model="ir.rule">
        <field name="name">Google Business Post: company isolation</field>
        <field name="model_id" ref="model_google_business_post"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('gs_google_business.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
