<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Location — Form View
         ============================================================ -->
    <record id="google_business_location_view_form" model="ir.ui.view">
        <field name="name">google.business.location.view.form</field>
        <field name="model">google.business.location</field>
        <field name="arch" type="xml">
            <form string="Google Business Location">
                <header>
                    <button name="action_start_oauth"
                            string="Connect to Google"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_oauth"
                            string="Reconnect"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('error', 'pending')"/>
                    <button name="action_sync_now"
                            string="Sync Now"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'connected'"/>
                    <button name="action_disconnect"
                            string="Disconnect"
                            type="object"
                            class="btn-secondary"
                            confirm="Are you sure you want to disconnect this location from Google?"
                            invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reviews"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-star">
                            <div class="o_stat_info">
                                <field name="review_count" class="o_stat_value"/>
                                <span class="o_stat_text">Reviews</span>
                            </div>
                        </button>
                        <button name="action_view_reviews"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-comment-o"
                                invisible="unanswered_review_count == 0">
                            <div class="o_stat_info">
                                <field name="unanswered_review_count" class="o_stat_value"/>
                                <span class="o_stat_text">Unanswered</span>
                            </div>
                        </button>
                        <button name="action_view_media"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-image">
                            <div class="o_stat_info">
                                <field name="media_count" class="o_stat_value"/>
                                <span class="o_stat_text">Media</span>
                            </div>
                        </button>
                        <button name="action_view_posts"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bullhorn">
                            <div class="o_stat_info">
                                <field name="post_count" class="o_stat_value"/>
                                <span class="o_stat_text">Posts</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Location Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Location Details">
                            <field name="google_location_id"
                                   placeholder="accounts/123/locations/456"/>
                            <field name="google_account_id"/>
                            <field name="primary_category"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Performance">
                            <field name="average_rating" widget="float" digits="[4,2]"/>
                            <field name="last_sync_date"/>
                            <field name="sync_error_message"
                                   invisible="state != 'error'"
                                   widget="text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact Info" name="contact">
                            <group>
                                <group string="Address">
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="zip_code"/>
                                    <field name="country_id"/>
                                </group>
                                <group string="Contact">
                                    <field name="phone"/>
                                    <field name="website" widget="url"/>
                                </group>
                            </group>
                        </page>
                        <page string="Business Hours" name="hours">
                            <div class="d-flex justify-content-end mb-2">
                                <button name="action_set_standard_hours"
                                        string="Set Mon–Fri 09:00–17:00 (Default)"
                                        type="object"
                                        class="btn btn-sm btn-secondary"
                                        confirm="This will replace all existing hours with the default Mon–Fri schedule. Continue?"/>
                            </div>
                            <field name="hours_ids" widget="one2many_list">
                                <list editable="bottom"
                                      decoration-muted="is_closed">
                                    <field name="day_of_week" required="1"/>
                                    <field name="is_closed"/>
                                    <field name="open_time"
                                           widget="float_time"
                                           invisible="is_closed"
                                           optional="show"/>
                                    <field name="close_time"
                                           widget="float_time"
                                           invisible="is_closed"
                                           optional="show"/>
                                    <field name="open_time_display"
                                           string="Opens"
                                           readonly="True"
                                           invisible="not is_closed"
                                           optional="show"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert">
                                <i class="fa fa-info-circle"/> Add multiple rows for the same day to model
                                split shifts (e.g. lunch break). Tick <strong>Closed</strong> to mark a
                                full-day closure. Times use 24-hour format.
                            </div>
                        </page>
                        <page string="OAuth Credentials" name="oauth"
                              groups="gs_google_business.group_manager">
                            <group>
                                <field name="oauth_client_id"/>
                                <field name="oauth_client_secret" password="True"/>
                                <field name="token_expiry"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Location — List View
         ============================================================ -->
    <record id="google_business_location_view_list" model="ir.ui.view">
        <field name="name">google.business.location.view.list</field>
        <field name="model">google.business.location</field>
        <field name="arch" type="xml">
            <list string="Google Business Locations"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'draft'"
                  decoration-success="state == 'connected'">
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="phone"/>
                <field name="average_rating" widget="float" digits="[4,1]" string="Rating"/>
                <field name="review_count"/>
                <field name="unanswered_review_count" string="Unanswered"/>
                <field name="last_sync_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Location — Kanban View
         ============================================================ -->
    <record id="google_business_location_view_kanban" model="ir.ui.view">
        <field name="name">google.business.location.view.kanban</field>
        <field name="model">google.business.location</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="review_count"/>
                <field name="unanswered_review_count"/>
                <field name="average_rating"/>
                <field name="last_sync_date"/>
                <progressbar field="state"
                             colors='{"connected": "success", "error": "danger", "pending": "warning", "draft": "200"}'/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="o_kanban_record_subtitle text-muted">
                                    <field name="city"/> <field name="country_id"/>
                                </span>
                            </div>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'connected': 'badge-success', 'error': 'badge-danger', 'pending': 'badge-warning', 'draft': 'badge-secondary'}}"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div class="d-flex justify-content-between mt-2">
                                <span>
                                    <i class="fa fa-star text-warning"/> <field name="average_rating" digits="[3,1]"/>
                                </span>
                                <span>
                                    <i class="fa fa-comments-o"/> <field name="review_count"/> reviews
                                </span>
                                <span class="text-danger" invisible="unanswered_review_count == 0">
                                    <i class="fa fa-exclamation-circle"/> <field name="unanswered_review_count"/> pending
                                </span>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <span class="text-muted small">
                                Last sync: <field name="last_sync_date" widget="date"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
         Location — Search View
         ============================================================ -->
    <record id="google_business_location_view_search" model="ir.ui.view">
        <field name="name">google.business.location.view.search</field>
        <field name="model">google.business.location</field>
        <field name="arch" type="xml">
            <search string="Search Locations">
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="primary_category"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="filter_connected" string="Connected"
                        domain="[('state', '=', 'connected')]"/>
                <filter name="filter_error" string="Error"
                        domain="[('state', '=', 'error')]"/>
                <filter name="filter_draft" string="Not Connected"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_unanswered" string="Has Unanswered Reviews"
                        domain="[('review_ids.is_replied', '=', False)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Connection Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_country" string="Country"
                            context="{'group_by': 'country_id'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
