<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Review — Form View
         ============================================================ -->
    <record id="google_business_review_view_form" model="ir.ui.view">
        <field name="name">google.business.review.view.form</field>
        <field name="model">google.business.review</field>
        <field name="arch" type="xml">
            <form string="Google Business Review">
                <header>
                    <button name="action_reply"
                            string="Reply to Review"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'replied'"/>
                    <button name="action_reply"
                            string="Update Reply"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'replied'"/>
                    <button name="action_mark_read"
                            string="Mark as Read"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'new'"/>
                    <button name="action_flag"
                            string="Flag"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'flagged'"/>
                    <button name="action_open_on_google"
                            string="View on Google"
                            type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,read,replied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="reviewer_name" string="Reviewer"/>
                        <h1>
                            <field name="reviewer_name" placeholder="Anonymous"/>
                        </h1>
                        <h2>
                            <field name="rating_label" widget="priority"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Review Details">
                            <field name="location_id"/>
                            <field name="review_date"/>
                            <field name="google_review_id" readonly="True"/>
                        </group>
                        <group string="Assignment">
                            <field name="assigned_user_id"/>
                            <field name="is_replied"/>
                            <field name="latest_reply_date"
                                   invisible="not is_replied"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Review" name="review_text">
                            <field name="review_text" widget="html" readonly="True"
                                   placeholder="(No review text — rating only)"/>
                        </page>
                        <page string="Current Reply" name="current_reply"
                              invisible="not is_replied">
                            <field name="latest_reply_text" widget="text" readonly="True"/>
                        </page>
                        <page string="Reply History" name="reply_history">
                            <field name="reply_ids" widget="one2many_list" readonly="True">
                                <list>
                                    <field name="reply_date"/>
                                    <field name="author_id"/>
                                    <field name="canned_response_id"/>
                                    <field name="is_published" widget="boolean"/>
                                    <field name="reply_text"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Review — List View
         ============================================================ -->
    <record id="google_business_review_view_list" model="ir.ui.view">
        <field name="name">google.business.review.view.list</field>
        <field name="model">google.business.review</field>
        <field name="arch" type="xml">
            <list string="Google Business Reviews"
                  decoration-danger="state == 'flagged'"
                  decoration-success="state == 'replied'"
                  decoration-info="state == 'new'">
                <field name="review_date"/>
                <field name="location_id"/>
                <field name="reviewer_name"/>
                <field name="rating_label" string="Rating" widget="priority"/>
                <field name="review_text" optional="show"/>
                <field name="assigned_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="is_replied" widget="boolean" string="Replied"/>
                <field name="latest_reply_date" optional="hide" string="Reply Date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'replied'"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'read'"
                       decoration-danger="state == 'flagged'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Review — Kanban View
         ============================================================ -->
    <record id="google_business_review_view_kanban" model="ir.ui.view">
        <field name="name">google.business.review.view.kanban</field>
        <field name="model">google.business.review</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <field name="reviewer_name"/>
                <field name="rating_label"/>
                <field name="review_text"/>
                <field name="location_id"/>
                <field name="assigned_user_id"/>
                <field name="is_replied"/>
                <field name="review_date"/>
                <progressbar field="state"
                             colors='{"replied": "success", "flagged": "danger", "new": "info", "read": "200"}'/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="reviewer_name"/>
                                </strong>
                                <span class="o_kanban_record_subtitle text-muted">
                                    <field name="location_id"/>
                                </span>
                            </div>
                            <field name="assigned_user_id" widget="many2one_avatar_user"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div class="mb-1">
                                <field name="rating_label" widget="priority"/>
                                <span class="ms-2 text-muted small">
                                    <field name="review_date" widget="date"/>
                                </span>
                            </div>
                            <p class="text-truncate" style="max-height:60px;overflow:hidden;">
                                <field name="review_text"/>
                            </p>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'replied': 'badge-success', 'flagged': 'badge-danger', 'new': 'badge-info', 'read': 'badge-secondary'}}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
         Review — Activity View
         ============================================================ -->
    <record id="google_business_review_view_activity" model="ir.ui.view">
        <field name="name">google.business.review.view.activity</field>
        <field name="model">google.business.review</field>
        <field name="arch" type="xml">
            <activity string="Google Business Reviews">
                <field name="reviewer_name"/>
                <field name="location_id"/>
                <field name="rating_label"/>
                <field name="review_date"/>
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="reviewer_name" display="full" class="o_text_block"/>
                            <field name="location_id" display="full" class="o_text_block text-muted"/>
                        </div>
                        <div>
                            <field name="rating_label" widget="priority"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- ============================================================
         Review — Pivot View
         ============================================================ -->
    <record id="google_business_review_view_pivot" model="ir.ui.view">
        <field name="name">google.business.review.view.pivot</field>
        <field name="model">google.business.review</field>
        <field name="arch" type="xml">
            <pivot string="Review Analytics" disable_linking="false">
                <field name="location_id" type="row"/>
                <field name="rating_label" type="col"/>
                <field name="review_date" interval="month" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================
         Review — Graph View
         ============================================================ -->
    <record id="google_business_review_view_graph" model="ir.ui.view">
        <field name="name">google.business.review.view.graph</field>
        <field name="model">google.business.review</field>
        <field name="arch" type="xml">
            <graph string="Review Analytics" type="bar" stacked="1">
                <field name="location_id" type="row"/>
                <field name="rating_label" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================
         Review — Search View
         ============================================================ -->
    <record id="google_business_review_view_search" model="ir.ui.view">
        <field name="name">google.business.review.view.search</field>
        <field name="model">google.business.review</field>
        <field name="arch" type="xml">
            <search string="Search Reviews">
                <field name="reviewer_name"/>
                <field name="review_text"/>
                <field name="location_id"/>
                <field name="assigned_user_id"/>
                <separator/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_unanswered" string="Unanswered"
                        domain="[('is_replied', '=', False)]"/>
                <filter name="filter_replied" string="Replied"
                        domain="[('state', '=', 'replied')]"/>
                <filter name="filter_flagged" string="Flagged"
                        domain="[('state', '=', 'flagged')]"/>
                <separator/>
                <filter name="filter_5star" string="5 Stars"
                        domain="[('rating_label', '=', 'FIVE')]"/>
                <filter name="filter_low" string="1–2 Stars"
                        domain="[('rating_label', 'in', ['ONE', 'TWO'])]"/>
                <filter name="filter_mine" string="My Reviews"
                        domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_location" string="Location"
                            context="{'group_by': 'location_id'}"/>
                    <filter name="group_rating" string="Star Rating"
                            context="{'group_by': 'rating_label'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_assignee" string="Assigned To"
                            context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_date" string="Review Date"
                            context="{'group_by': 'review_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
